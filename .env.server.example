# Docker Compose 自身配置
QQ_BOT_IMAGE=ghcr.io/fncheng/qqbot:latest
POSTGRES_DB=qq_bot
POSTGRES_USER=qq_bot
POSTGRES_PASSWORD=请替换为仅包含字母和数字的强密码
NAPCAT_UID=1000
NAPCAT_GID=1000

# QQ 机器人配置
# 必须与 NapCatQQ WebSocket 服务端中设置的 Token 完全一致。
NAPCAT_TOKEN=请替换为强随机Token
# 机器人所有者的个人 QQ 号，可留空；不是登录 NapCatQQ 的机器人 QQ 号。
BOT_OWNER_QQ=
# 允许机器人回复的 QQ 群号，多个群号使用英文逗号分隔。
ALLOWED_GROUP_IDS=
# 已同意文本归档并启用每日总结的群号，必须是 ALLOWED_GROUP_IDS 的子集；留空时关闭归档。
GROUP_SUMMARY_ENABLED_GROUP_IDS=
GROUP_SUMMARY_TIMEZONE=Asia/Shanghai
GROUP_SUMMARY_RETENTION_DAYS=7
GROUP_SUMMARY_CACHE_RETENTION_DAYS=30
GROUP_SUMMARY_CLEANUP_INTERVAL_MS=3600000
GROUP_SUMMARY_CHUNK_CHAR_LIMIT=6000
GROUP_SUMMARY_MAX_SOURCE_MESSAGES=2000
GROUP_SUMMARY_MAX_SOURCE_CHARS=100000

# OpenAI 配置
OPENAI_API_KEY=请替换为OpenAIAPIKey
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# 留空时使用模型默认行为；none 表示请求关闭推理，其他可选值为 minimal、low、medium、high、xhigh。
LLM_REASONING_EFFORT=
OPENAI_SYSTEM_PROMPT=你是一个友善、简洁的 QQ 助手。
LLM_HISTORY_LIMIT=20

# 业务服务配置
HOST=0.0.0.0
PORT=3000
ONEBOT_REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000
