# Docker Compose 自身配置
POSTGRES_DB=qq_bot
POSTGRES_USER=qq_bot
POSTGRES_PASSWORD=请替换为仅包含字母和数字的强密码
NAPCAT_UID=1000
NAPCAT_GID=1000

# QQ 机器人配置
# 必须与 NapCatQQ WebSocket 服务端中设置的 Token 完全一致。
NAPCAT_TOKEN=请替换为强随机Token
# 机器人所有者的个人 QQ 号，可留空；不是登录 NapCatQQ 的机器人 QQ 号。
BOT_OWNER_QQ=
# 允许机器人回复的 QQ 群号，多个群号使用英文逗号分隔。
ALLOWED_GROUP_IDS=

# OpenAI 配置
OPENAI_API_KEY=请替换为OpenAIAPIKey
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SYSTEM_PROMPT=你是一个友善、简洁的 QQ 助手。
LLM_HISTORY_LIMIT=20

# 业务服务配置
HOST=0.0.0.0
PORT=3000
ONEBOT_REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000
